#!/usr/bin/env python3
"""Plot held-out goal-slice collapse metrics for the two Rooms-8 seeds."""

import argparse
import json
from pathlib import Path

import matplotlib
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D


RUNS_DIR = Path(__file__).resolve().parent / "goal_slice_gcb_runs"
DEFAULT_OUTPUT = Path(__file__).resolve().parent / "figures" / "goal_slice_gcb_rooms8_collapse.pdf"
RUN_NAMES = {
    "seed 0": "goal-slice-gcb-rooms8-fdim256-rmin-0.25-iters50000-bs256-qhit1-seed0",
    "seed 1": "goal-slice-gcb-rooms8-fdim256-rmin-0.25-iters50000-bs256-qhit1-seed1",
}
METRICS = (
    "stats_eval/collapse/separation_ratio",
    "stats_eval/collapse/between_status_distance",
    "stats_eval/collapse/within_status_distance",
)


def read_metrics(path):
    """Return complete stats-eval collapse values, indexed by metric."""
    values = {metric: [] for metric in METRICS}
    with path.open(encoding="utf-8") as metrics_file:
        for line_number, line in enumerate(metrics_file, start=1):
            try:
                record = json.loads(line)
            except json.JSONDecodeError as error:
                raise ValueError(f"Invalid JSON in {path}:{line_number}") from error
            if "step" not in record or not all(metric in record for metric in METRICS):
                continue
            if not isinstance(record["step"], (int, float)):
                raise ValueError(f"Non-numeric step in {path}:{line_number}")
            for metric in METRICS:
                if not isinstance(record[metric], (int, float)):
                    raise ValueError(f"Non-numeric {metric!r} in {path}:{line_number}")
                values[metric].append((record["step"], record[metric]))
    if not values[METRICS[0]]:
        raise ValueError(f"No complete stats_eval collapse records found in {path}")
    return values


def exponential_moving_average(values, decay=0.90):
    """Return an EMA whose current observation receives weight 1 - decay."""
    ema_values = []
    ema = None
    for value in values:
        ema = value if ema is None else decay * ema + (1.0 - decay) * value
        ema_values.append(ema)
    return ema_values


def plot(run_paths, output, use_tex):
    matplotlib.rcParams.update({
        "text.usetex": use_tex,
        "font.family": "serif" if use_tex else "DejaVu Serif",
        "axes.labelsize": 13,
        "axes.titlesize": 14,
        "legend.fontsize": 11,
    })
    fig, ratio_axis = plt.subplots(figsize=(7.2, 4.6))
    distance_axis = ratio_axis.twinx()
    seed_handles = []

    for colour, (label, path) in zip(plt.get_cmap("tab10").colors, run_paths):
        metrics = read_metrics(path)
        ratio_steps, ratios = zip(*metrics[METRICS[0]])
        ratio_axis.plot(
            ratio_steps, ratios, color=colour, linewidth=1.2, alpha=0.25, zorder=1,
        )
        ratio_axis.plot(
            ratio_steps, exponential_moving_average(ratios), color=colour,
            linewidth=2.2, zorder=2,
        )
        distance_axis.plot(*zip(*metrics[METRICS[1]]), color=colour, linewidth=1.9, linestyle="--")
        distance_axis.plot(*zip(*metrics[METRICS[2]]), color=colour, linewidth=1.9, linestyle=":")
        seed_handles.append(Line2D([0], [0], color=colour, linewidth=2.2, label=label))

    ratio_axis.set_xlabel(r"Training step")
    ratio_axis.set_ylabel(r"Separation ratio $d_{\mathrm{between}} / d_{\mathrm{within}}$")
    distance_axis.set_ylabel(r"Status distance")
    ratio_axis.set_title(r"Held-out goal-status collapse diagnostics")
    ratio_axis.grid(axis="y", alpha=0.28)
    ratio_axis.set_axisbelow(True)
    metric_handles = [
        Line2D([0], [0], color="black", linewidth=1.2, linestyle="-", alpha=0.25,
               label=r"raw separation ratio (left)"),
        Line2D([0], [0], color="black", linewidth=2.2, linestyle="-",
               label=r"EMA-0.90 separation ratio (left)"),
        Line2D([0], [0], color="black", linewidth=1.9, linestyle="--",
               label=r"between-status distance (right)"),
        Line2D([0], [0], color="black", linewidth=1.9, linestyle=":",
               label=r"within-status distance (right)"),
    ]
    fig.legend(
        handles=metric_handles, loc="lower center", bbox_to_anchor=(0.5, 0.09),
        ncol=3, frameon=False,
    )
    fig.legend(
        handles=seed_handles, loc="lower center", bbox_to_anchor=(0.5, 0.01),
        ncol=2, frameon=False,
    )
    fig.subplots_adjust(bottom=0.25, left=0.13, right=0.87, top=0.89)
    output.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(output, bbox_inches="tight")
    plt.close(fig)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--runs-dir", type=Path, default=RUNS_DIR)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--usetex", action="store_true",
                        help="Render all figure text with the system LaTex installation.")
    args = parser.parse_args()
    run_paths = [(label, args.runs_dir / name / "metrics.jsonl") for label, name in RUN_NAMES.items()]
    missing = [str(path) for _, path in run_paths if not path.is_file()]
    if missing:
        raise FileNotFoundError("Missing metrics file(s):\n  " + "\n  ".join(missing))
    plot(run_paths, args.output, args.usetex)
    print(f"Saved plot to {args.output}")


if __name__ == "__main__":
    main()
